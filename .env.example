# Botzilla Environment Configuration Example
# Copy this file to .env and fill in your values:
# cp .env.example .env

# Discord Bot Token (Required)
# Obtained from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Dry Run Mode (Optional: true / false)
# If true, runs scrapers and processing without sending Discord messages
DRY_RUN=false

# Optional Overrides (default values are managed via config.json or docker-compose)
# DB_FILE=/app/data/botzilla.db
# LOG_FILE=/app/logs/botzilla.log
# LOG_LEVEL=INFO
